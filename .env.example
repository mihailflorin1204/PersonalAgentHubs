# Management API listen address. The default is loopback. A container sets
# HOST=0.0.0.0 and publishes the port only on 127.0.0.1.
HOST=127.0.0.1
PORT=3001

# PostgreSQL connection used by Drizzle. The API process still starts when this
# is unset, and /health reports the database as unconfigured until a connection succeeds.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agenthub

# Required before sign-in. At least 32 characters, and not the published
# placeholder. Put the real value in .env, which is not committed.
# BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3001
# Browser origins allowed to call Better Auth directly. The web app also proxies
# sign-in through itself and rewrites the origin to the API.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Management API the web console proxies to. Server-side only.
API_URL=http://127.0.0.1:3001
