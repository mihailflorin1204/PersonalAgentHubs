{
  "name": "agenthub",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "pnpm --filter @agenthub/api dev",
    "start": "pnpm --filter @agenthub/api start",
    "db:generate": "pnpm --filter @agenthub/database db:generate",
    "db:migrate": "pnpm --filter @agenthub/database db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
